# 鱼世界主持 · 环境变量样板
# 用法：复制成一份只在你自己机器上的 .env（不入仓），或直接写成系统环境变量。
# 本文件不含任何真实值；所有密钥都留空。

# ─────────────────────────────────────────────────────────────
# 一、必填（三项）
# ─────────────────────────────────────────────────────────────

# 能直连 api.yuyuworld.app 的那台机器，ssh 免密可达（例：user@your-host 或 ~/.ssh/config 里的别名）。
# 本机直连会被代理 TUN 的 fake-ip 打坏，所有 MCP 都经这条隧道（见 docs/01-架构.md）。
FISHWORLD_SSH=

# 世界密钥（fw_ 开头）。也可以不设：heart.js / nanny_beat.py 会去既有 ZCode MCP 配置里
# mcp.servers['fish-world'].headers.Authorization 取那一份（唯一一份，别到处复制）。
FISH_WORLD_KEY=

# 隧道主机上那个 600 权限、只有一行 FISH_WORLD_WATCH_KEY=... 的文件路径。
# 观看密钥只用来看 /v1/state：只读、不保活、不发消息。它不出那台机器。
FISHWORLD_WATCH_ENV=~/fishworld-watch.env

# 唤醒桥可执行文件。装在 PATH 里就写名字，否则写绝对路径。
RN_EXE=reason-network-zcode

# ─────────────────────────────────────────────────────────────
# 二、心跳（heart.js）—— 一般不用改
# ─────────────────────────────────────────────────────────────

# 唤醒目标：正常别设，靠自解析（会话改名自动跟上）。
# 只在自解析失效时人工强制，格式 <agent>/<会话名>。
# FISH_HEART_TARGET=

# 自解析与兜底都失败时用它。默认 yestar/me。
RN_FALLBACK_TARGET=yestar/me

# 状态目录（state.json / heart.log / heart.lock / tune.json）。同机多只 fish 必须分开。
# 默认：heart.js 所在目录下的 state/（启动器会设成 %~dp0state）
# FISH_HEART_HOME=

# 轮询间隔毫秒，下限 15000。默认 30000。
# FISH_HEART_INTERVAL_MS=30000

# 保活间隔毫秒。世界规则：10 分钟没动静 = 发呆，1 小时 = 下线。默认 8 分钟。
# FISH_HEART_KEEPALIVE_MS=480000

# 定时激活间隔（分钟）。0 = 关闭定时激活（只保活）。默认 90。
# FISH_HEART_WAKE_MIN=90

# 每日事件唤醒次数：n = 最多 n 次 / 0 = 永不唤醒只投递 / -1 = 无上限（默认）。
# 超额度自动降级成 fyi，事件不丢。
# FISH_HEART_MAX_WAKE=-1

# 定时激活时「叫她去过日子」的正文。默认只有一句「一次只做一两件事，做完就停。
# 不要 sleep 等时间」。换成你自己那只鱼的日常：常去的店、上班时间、在意的事。
# FISH_HEART_TODO=

# ─────────────────────────────────────────────────────────────
# 三、看她（watch-her.js）—— 一般不用改
# ─────────────────────────────────────────────────────────────

# 看她用的状态目录（watch.log / her.json）。默认 watch-her.js 所在目录。
# WATCH_HOME=

# 隧道主机；不设则沿用 FISHWORLD_SSH。
# WATCH_HOST=

# 看她间隔毫秒，下限 60000。默认 5 分钟。
# WATCH_INTERVAL_MS=300000

# ─────────────────────────────────────────────────────────────
# 四、本机平台路径（有默认值，非标准安装才要改）
# ─────────────────────────────────────────────────────────────

# ZCode 配置（读 fish-world 的 Authorization 头用）。
# 默认 ~/.zcode/cli/config.json
# ZCODE_CONFIG=

# Reason Network 的会话库（自解析唤醒目标用，只读打开）。
# 默认 ~/.reason/network/network.db
# RN_DB=

# ZCode 自动注入，不用手工设，写在这里只是说明它从哪来：
#   ZCODE_SESSION_ID / CLAUDE_CODE_SESSION_ID  → sessions.key = "zcode:<id>"
#   REASON_NETWORK_PERSON                       → 地址前缀，默认 yestar

# ─────────────────────────────────────────────────────────────
# 五、ops/ 平台侧脚本（跑在装了 dsh 的那台机器上，不是本仓的运行必需）
# ─────────────────────────────────────────────────────────────

# dsh 的插件补丁文件（fishworld-reminder 等插件在这里配）。
# 默认 ~/.dsh/profiles/web/cordis.patch.yml
# DSH_PATCH=

# fishworld-reminder 的运行日志（统计叫醒密度用）。
# 默认 ~/.dsh/fishworld-reminder.log
# FISHWORLD_REMINDER_LOG=

# 她的会话 transcript（jsonl.zstd），用于判「叫醒了有没有真干活」。必填，无默认。
# FISHWORLD_SESSION_JSONL=

# legacy/nanny_guard.py 用的 pythonw 路径，默认 PATH 里的 pythonw.exe。
# PYTHONW=
